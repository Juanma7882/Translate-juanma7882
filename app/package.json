{
  "name": "translate-app",
  "version": "0.1.0",
  "private": true,
  "author": "juan <juanmaf236@gmail.com>",
  "description": "Traductor de pantalla y audio (shell de Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "stage:native": "node ../scripts/stage-native.mjs",
    "pack:dir": "npm run build && npm run stage:native && electron-builder --dir --publish never",
    "dist": "npm run build && npm run stage:native && electron-builder --publish never",
    "smoke": "npm run build && TR_SMOKE=1 electron . --no-sandbox",
    "smoke:windows": "npm run build && TR_SMOKE=windows electron . --no-sandbox",
    "smoke:selector": "npm run build && TR_SMOKE=selector electron . --no-sandbox",
    "smoke:settings": "npm run build && TR_SMOKE=settings electron . --no-sandbox",
    "smoke:shell": "npm run build && TR_SMOKE=shell electron . --no-sandbox",
    "smoke:e2e": "npm run build && TR_SMOKE=e2e ../scripts/with-xvfb.sh electron . --no-sandbox"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "preact": "10.29.8",
    "tr-bindings": "file:../crates/tr-bindings",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
